# =============================================================================
# AuraDev ERP API — environment variables (copy to .env for local dev)
# =============================================================================

# --- Production (Railway / Render) ---------------------------------------------
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://your-pooler-host:6543/postgres?sslmode=require
DB_USERNAME=your-pooler-user
DB_PASSWORD=your-database-password

JWT_SECRET=replace-with-a-long-random-base64-string

# Frontend origin(s), comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# Public API URL (optional when frontend uses same-origin /uploads proxy)
APP_PUBLIC_BASE_URL=https://your-api-domain.example

# Writable directory for tenant logos. On Railway either:
#   1) Mount a volume at /var/data/uploads and set APP_UPLOADS_DIR=/var/data/uploads
#   2) Omit APP_UPLOADS_DIR to use ./uploads (ephemeral — lost on redeploy)
# APP_UPLOADS_DIR=/var/data/uploads

# --- Local dev ----------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=dev
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
# DB_USERNAME=postgres
# DB_PASSWORD=...
# JWT_SECRET=...
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# APP_PUBLIC_BASE_URL=http://localhost:8080


spring.profiles.active=dev

DB_URL=jdbc:postgresql://localhost:5433/auradev_erp
DB_USERNAME=auradev
DB_PASSWORD=auradev_local

JWT_SECRET=Fv/g3O0hDq3XYni0gNss/fKCtSO/oD6i1RRW/AfoA1pBGLXpoSMtZ42gM9lSX3Z6

CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_UPLOADS_DIR=uploads
